# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SCOPUS_API_KEY: Secure server-side Elsevier Scopus API key (never exposed in client code)
SCOPUS_API_KEY=""

# WOS_API_KEY: Secure server-side Clarivate Web of Science API key (never exposed in client code)
WOS_API_KEY=""

# Optional scholarly discovery integrations. Keep all credentials server-side.
# Sofya is an MCP server; configure its MCP endpoint for an MCP-capable client.
SOFYA_MCP_URL=""
SOFYA_MCP_API_KEY=""

# The Holistic Care is public; the key is optional.
HOLISTICCARE_API_URL="https://api.theholisticcare.com/v1"
HOLISTICCARE_API_KEY=""

# CORE requires an API key for registered access.
CORE_API_URL="https://api.core.ac.uk/v3"
CORE_API_KEY=""

# DataCite public metadata access works without a key.
DATACITE_API_URL="https://api.datacite.org"
DATACITE_API_KEY=""

# OSF and SHARE OSF expose public read access; tokens are optional.
OSF_API_URL="https://api.osf.io/v2"
OSF_API_TOKEN=""
SHARE_OSF_API_URL="https://share.osf.io/api/v2"
SHARE_OSF_API_TOKEN=""
